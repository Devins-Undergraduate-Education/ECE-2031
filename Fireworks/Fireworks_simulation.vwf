HEADER
{
	VERSION = 1;
	TIME_UNIT = ns;
	DATA_OFFSET = 0.0;
	DATA_DURATION = 100000.0;
	SIMULATION_TIME = 100000.0;
	GRID_PHASE = 0.0;
	GRID_PERIOD = 500.0;
	GRID_DUTY_CYCLE = 50;
}

USER_TYPE("__STATE")
{
	VALUES = "Undefined", "STATE.idle", "STATE.w1", "STATE.w0", "STATE.f", "STATE.oneOnce", "STATE.launch", "STATE.oneTwice";
}

USER_TYPE("|QualityMonitor|STATE")
{
	VALUES = "STATE.idle", "STATE.w1", "STATE.w0", "STATE.f";
}

SIGNAL("CLOCK")
{
	VALUE_TYPE = NINE_LEVEL_BIT;
	SIGNAL_TYPE = SINGLE_BIT;
	WIDTH = 1;
	LSB_INDEX = -1;
	DIRECTION = INPUT;
	PARENT = "";
}

SIGNAL("RESETN")
{
	VALUE_TYPE = NINE_LEVEL_BIT;
	SIGNAL_TYPE = SINGLE_BIT;
	WIDTH = 1;
	LSB_INDEX = -1;
	DIRECTION = INPUT;
	PARENT = "";
}

SIGNAL("B1")
{
	VALUE_TYPE = NINE_LEVEL_BIT;
