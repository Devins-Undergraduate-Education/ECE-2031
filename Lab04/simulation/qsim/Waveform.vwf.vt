`timescale 1 ps/ 1 ps
module Lab04_KMAP_vlg_vec_tst();
// constants                                           
// general purpose registers
reg clock;
reg feeding;
reg packing;
reg resetn;
// wires                                               
wire [1:0] Q;
wire Z;

// assign statements (if any)                          
Lab04_KMAP i1 (
// port map - connection between master ports and signals/registers   
	.clock(clock),
	.feeding(feeding),
	.packing(packing),
	.Q(Q),
	.resetn(resetn),
	.Z(Z)
);
initial 
begin 
#1000000 $finish;
end 

// clock
always
begin
	clock = 1'b0;
	clock = #25000 1'b1;
	#25000;
end 

// resetn
initial
begin
	resetn = 1'b1;
	resetn = #360000 1'b0;
	resetn = #50000 1'b1;
	resetn = #230000 1'b0;
	resetn = #50000 1'b1;
end 

// feeding
initial
begin
	feeding = 1'b0;
	feeding = #80000 1'b1;
	feeding = #350000 1'b0;
	feeding = #90000 1'b1;
	feeding = #260000 1'b0;
	feeding = #180000 1'b1;
end 

// packing
initial
begin
	packing = 1'b0;
	packing = #160000 1'b1;
	packing = #100000 1'b0;
	packing = #100000 1'b1;
	packing = #300000 1'b0;
	packing = #160000 1'b1;
	packing = #120000 1'b0;
end 
endmodule

