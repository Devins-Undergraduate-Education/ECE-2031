`timescale 1 ps/ 1 ps
module SafetyMonitor_vlg_vec_tst();
// constants                                           
// general purpose registers
reg disable_in;
reg estop;
reg flames;
reg gas;
reg intrusion;
reg temp;
// wires                                               
wire all_clear;
wire lockdown;
wire powerdown;
wire suppress;
wire ventilate;

// assign statements (if any)                          
SafetyMonitor i1 (
// port map - connection between master ports and signals/registers   
	.all_clear(all_clear),
	.disable_in(disable_in),
	.estop(estop),
	.flames(flames),
	.gas(gas),
	.intrusion(intrusion),
	.lockdown(lockdown),
	.powerdown(powerdown),
	.suppress(suppress),
	.temp(temp),
	.ventilate(ventilate)
);
initial 
begin 
#3200000 $finish;
end 

// disable_in
always
begin
	disable_in = 1'b0;
	disable_in = #1600000 1'b1;
	#1600000;
end 

// estop
always
begin
	estop = 1'b0;
	estop = #800000 1'b1;
	#800000;
end 

// flames
always
begin
	flames = 1'b0;
	flames = #400000 1'b1;
	#400000;
end 

// gas
always
begin
	gas = 1'b0;
	gas = #200000 1'b1;
	#200000;
end 

// intrusion
always
begin
	intrusion = 1'b0;
	intrusion = #100000 1'b1;
	#100000;
end 

// temp
always
begin
	temp = 1'b0;
	temp = #50000 1'b1;
	#50000;
end 
endmodule

