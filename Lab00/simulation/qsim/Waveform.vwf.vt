`timescale 1 ps/ 1 ps
module IntroCircuit_vlg_vec_tst();
// constants                                           
// general purpose registers
reg KEY0;
reg KEY1;
reg SW8;
reg SW9;
// wires                                               
wire LEDR0;
wire LEDR9;

// assign statements (if any)                          
IntroCircuit i1 (
// port map - connection between master ports and signals/registers   
	.KEY0(KEY0),
	.KEY1(KEY1),
	.LEDR0(LEDR0),
	.LEDR9(LEDR9),
	.SW8(SW8),
	.SW9(SW9)
);
initial 
begin 
#1000000 $finish;
end 

// KEY0
initial
begin
	KEY0 = 1'b1;
end 

// KEY1
initial
begin
	KEY1 = 1'b0;
	KEY1 = #80000 1'b1;
	KEY1 = #360000 1'b0;
end 

// SW8
initial
begin
	SW8 = 1'b0;
	SW8 = #380000 1'b1;
	SW8 = #380000 1'b0;
end 

// SW9
initial
begin
	SW9 = 1'b0;
	SW9 = #380000 1'b1;
	SW9 = #380000 1'b0;
end 
endmodule

